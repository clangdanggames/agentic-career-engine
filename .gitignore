# ===================================================
# Agentic Career Engine (ACE) — Privacy-First Gitignore
# ===================================================

# Ignore personal LinkedIn export data
network/*.csv
network/Connections.csv

# Ignore personal creator kits
SOCIAL_SHARE_KIT.md

# Ignore personalized user resumes and active dashboard
resumes/*_Resume_Master.md
resumes/*_Resume_*.md
resumes/*_Resume_*.pdf
resumes/variants/*_Resume_*.md
resumes/variants/*_Resume_*.pdf
DASHBOARD.md

# Ignore generated HTML and PDF files across the repo, EXCEPT showcase demo files
*.pdf
*.html
!examples/demo_showcase/*.pdf
!examples/demo_showcase/*.html

# Ignore real active application folders generated during job hunts
applications/20*
applications/*_applied/
applications/*_archive/
applications/.archive/

# Operating system and editor artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.bak
*~

# Log files and temporary crash dumps
*.log
scratch/

# Engine backups and update archives
.backups/
*.zip

# Internal ACE development skills & tools (not distributed to end-users)
.agents/skills/ace-dogfood-analyzer/
